# Settings for running the hub on a real home. deploy/home/setup_mac.sh copies this file to
# ~/.config/porch-hub/home.env (outside the repo, readable only by you); fill in that copy.
# deploy/home/discover.sh and deploy/home/start.sh load it for you. To load it by hand:
#
#   set -a; source ~/.config/porch-hub/home.env; set +a
#
# Never commit the filled-in copy, and never paste the token into chat.

# Only the platforms set below; no simulated devices mixed in.
PORCH_REAL_DEVICES_ONLY=1
PORCH_HOME_ID=home-1

# LG ThinQ. Token from https://connect-pat.lgthinq.com, signed in with the LG account the
# appliances are registered to, with these scopes: view devices, view device status,
# device control, event subscription, push notifications.
LG_THINQ_PAT=
LG_THINQ_COUNTRY=US
# From `python -m porch_hub.discover`, then edited:
# LG_THINQ_BINDINGS='{"<LG device id>": {"porch_id": "home-1/air-purifier", "room": "Living room"}}'

# Matter: the Matter Server running on this computer (see docs/REAL_HOME.md, step 2).
MATTER_SERVER_URL=ws://127.0.0.1:5580/ws
# From `python -m porch_hub.discover`, then edited:
# MATTER_BINDINGS='{"1/1": {"porch_id": "home-1/entry-light", "room": "Entry"}}'

# Keep a copy of the real devices, so offline mode shows them and not the demo home.
DIGITAL_COPY_PATH=~/.config/porch-hub/digital-copy.json

# The gateway's config for this home (agents, keys, what each plug powers). deploy/home/start.sh
# uses this path unless you set another one here.
# PORCH_GATEWAY_CONFIG=~/.config/porch-hub/porch_config.json
