# Settings for running the hub on a real home. deploy/home/setup_mac.sh copies this file to
# ~/.config/porch-hub/home.env (outside the repo, readable only by you); fill in that copy.
# deploy/home/discover.sh and deploy/home/start.sh load it for you. To load it by hand:
#
#   set -a; source ~/.config/porch-hub/home.env; set +a
#
# Never commit the filled-in copy, and never paste the token into chat.

# Only the platforms set below; no simulated devices mixed in.
PORCH_REAL_DEVICES_ONLY=1
PORCH_HOME_ID=home-1

# LG ThinQ. Token from https://connect-pat.lgthinq.com, signed in with the LG account the
# appliances are registered to, with these scopes: view devices, view device status,
# device control, event subscription, push notifications.
LG_THINQ_PAT=
# The country of the LG account the appliances are registered to (US, KR, ...), not where you
# live now. With the wrong country LG answers "not allowed" (its codes 1305 and 1309).
LG_THINQ_COUNTRY=US
# From `python -m porch_hub.discover`, then edited:
# LG_THINQ_BINDINGS='{"<LG device id>": {"porch_id": "home-1/air-purifier", "room": "Living room"}}'

# Matter: the Matter Server running on this computer (see docs/REAL_HOME.md, step 2).
MATTER_SERVER_URL=ws://127.0.0.1:5580/ws
# From `python -m porch_hub.discover`, then edited:
# MATTER_BINDINGS='{"1/1": {"porch_id": "home-1/entry-light", "room": "Entry"}}'
# A binding may also give "name" (what you call the device) and "read_only": true (the hub reads
# it and never switches it: for the plug that powers the Wi-Fi router):
# MATTER_BINDINGS='{"2/1": {"porch_id": "home-1/router-plug", "room": "Living room", "name": "Router plug", "read_only": true}}'

# Google Home, through Google's Home MCP server: lights can be switched, plugs are read only,
# and a TV is read and can be played and paused.
# Uncomment after `deploy/home/connect.sh google` has signed in (docs/REAL_HOME.md, "Google Home").
# GOOGLE_HOME_DIRECTORY=~/.config/porch-hub/google-home
# From `deploy/home/discover.sh`, then edited. A binding without "room" keeps Google's room, and
# "read_only": true makes the hub read the device and offer no command for it:
# GOOGLE_HOME_BINDINGS='{"<Google device id>": {"porch_id": "home-1/living-room-lamp", "room": "Living room"}}'

# Ring doorbells, read only. Uncomment after `deploy/home/connect.sh ring` (docs/REAL_HOME.md, "Ring doorbell").
# RING_AUTHORIZATION_FILE=~/.config/porch-hub/ring-authorization.json
# From `deploy/home/discover.sh`, then edited:
# RING_BINDINGS='{"<Ring device id>": {"porch_id": "home-1/front-doorbell", "room": "Entry"}}'

# Family protection. With PORCH_REAL_DEVICES_ONLY=1 the hub sends nothing to a device until you
# open a control window: the Family protection button at the top of every hub page, after
# choosing your owner PIN once with deploy/home/owner.sh set-pin
# (or, from Terminal: deploy/home/owner.sh allow --device <device id>).
# To turn it off, for a demo table with nobody around the devices, uncomment:
# PORCH_FAMILY_PROTECTION=0

# This home's floor plan for the digital twin and the 3D view: rooms, and where each device sits.
# Copy deploy/home-layout.example.json there and edit it (porch_hub/layout.py says how).
# PORCH_HOME_LAYOUT=~/.config/porch-hub/home-layout.json

# Keep a copy of the real devices, so offline mode shows them and not the demo home.
DIGITAL_COPY_PATH=~/.config/porch-hub/digital-copy.json

# The gateway's config for this home (agents, keys, what each plug powers). deploy/home/start.sh
# uses this path unless you set another one here.
# PORCH_GATEWAY_CONFIG=~/.config/porch-hub/porch_config.json
