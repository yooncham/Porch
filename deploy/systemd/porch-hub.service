[Unit]
Description=Porch Device Hub (Interface v0)
After=network.target
[Service]
WorkingDirectory=/opt/porch-app
Environment=PYTHONUNBUFFERED=1
Environment=DIGITAL_COPY_PATH=/var/lib/porch-hub/digital-copy.json
ExecStart=/opt/porch-app/.venv/bin/uvicorn porch_hub.main:app --host 127.0.0.1 --port 8100
Restart=always
[Install]
WantedBy=multi-user.target
